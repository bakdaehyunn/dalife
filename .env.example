TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ADMIN_USER_IDS=
DARCHIVE_ALLOW_ALL_CHATS=false
DARCHIVE_NATIVE_PERSONAL_TELEGRAM=false
DARCHIVE_LIFE_TIMEZONE=Asia/Seoul

DARCHIVE_STATE_DIR=.local/state
DARCHIVE_LOG_DIR=.local/logs
DARCHIVE_MEDIA_DIR=.local/captures

DARCHIVE_CODEX_ENABLED=true
# Bare "codex" is resolved from PATH plus common Homebrew paths. Use an absolute
# path such as /opt/homebrew/bin/codex if launchd diagnostics still fail.
DARCHIVE_CODEX_BIN=codex
DARCHIVE_CODEX_MODEL=
DARCHIVE_CODEX_SANDBOX=read-only
DARCHIVE_CODEX_EPHEMERAL=true
DARCHIVE_CODEX_TIMEOUT_SEC=900
DARCHIVE_PROCESSOR_BATCH_SIZE=10

# Optional food collection providers. Daily soft limits are intentionally below
# provider hard limits and are enforced from the SQLite query ledger.
KAKAO_REST_API_KEY=
DARCHIVE_KAKAO_DAILY_SOFT_LIMIT=1000
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
DARCHIVE_NAVER_DAILY_SOFT_LIMIT=100
DARCHIVE_FOOD_BLOG_ALLOWED_DOMAINS=blog.naver.com

# Optional. If installed, the fallback processor can use local OCR when Codex is disabled.
DARCHIVE_TESSERACT_BIN=tesseract
