TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ADMIN_USER_IDS=
DALIFE_ALLOW_ALL_CHATS=false
DALIFE_NATIVE_PERSONAL_TELEGRAM=false
DALIFE_LIFE_TIMEZONE=Asia/Seoul

DALIFE_STATE_DIR=.local/state
DALIFE_LOG_DIR=.local/logs
DALIFE_MEDIA_DIR=.local/captures

DALIFE_CODEX_ENABLED=true
# Bare "codex" is resolved from PATH plus common Homebrew paths. Use an absolute
# path such as /opt/homebrew/bin/codex if launchd diagnostics still fail.
DALIFE_CODEX_BIN=codex
DALIFE_CODEX_MODEL=
DALIFE_CODEX_SANDBOX=read-only
DALIFE_CODEX_EPHEMERAL=true
DALIFE_CODEX_TIMEOUT_SEC=900
DALIFE_PROCESSOR_BATCH_SIZE=10

# Optional food collection providers. Daily soft limits are intentionally below
# provider hard limits and are enforced from the SQLite query ledger.
KAKAO_REST_API_KEY=
DALIFE_KAKAO_DAILY_SOFT_LIMIT=1000
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
DALIFE_NAVER_DAILY_SOFT_LIMIT=100
DALIFE_FOOD_BLOG_ALLOWED_DOMAINS=blog.naver.com

# Optional. If installed, the fallback processor can use local OCR when Codex is disabled.
DALIFE_TESSERACT_BIN=tesseract
